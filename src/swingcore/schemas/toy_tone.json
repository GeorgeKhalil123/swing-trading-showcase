{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swingcore/toy_tone.json",
  "title": "toy_headline_agent (TOY)",
  "description": "A toy schema written for the showcase demo. The agent reads synthetic headlines and names their tone, citing the ones it relied on verbatim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "ticker", "as_of", "tone", "cited"],
  "properties": {
    "agent": {"const": "toy_headline_agent"},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.\\-]{1,10}$"},
    "as_of": {"type": "string", "minLength": 10},
    "tone": {"enum": ["positive", "negative", "mixed"]},
    "cited": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
